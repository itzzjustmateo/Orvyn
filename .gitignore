# Keep the repository limited to source code. The USB also contains private data.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/START.bat
!/ORVYN.bat
!/BEHEER.bat
!/apps/
!/scripts/
!/config/
!/tests/
!/tools/
!/docs/

/apps/*
!/apps/web-ui/
!/apps/manager/
/apps/web-ui/*
!/apps/web-ui/src/
!/apps/web-ui/public/
!/apps/web-ui/package.json
!/apps/web-ui/package-lock.json
!/apps/web-ui/tsconfig.json
!/apps/web-ui/next.config.ts
!/apps/web-ui/next-env.d.ts
!/apps/web-ui/postcss.config.mjs
!/apps/web-ui/eslint.config.mjs
!/apps/web-ui/components.json
!/apps/web-ui/desktop-entry.tsx
!/apps/web-ui/build-desktop.mjs
!/apps/web-ui/.gitignore
/apps/manager/*
!/apps/manager/src/
!/apps/manager/assets/
!/apps/manager/Cargo.toml
!/apps/manager/Cargo.lock
!/apps/manager/build.rs
!/apps/manager/.gitignore
!/apps/manager/packaging/
/apps/manager/packaging/*
!/apps/manager/packaging/installer.iss
!/apps/manager/packaging/INSTALL.txt
!/apps/manager/packaging/test-installer.ps1
!/apps/manager/packaging/licenses/

/config/*
!/config/*.example.json
/scripts/*
!/scripts/*.ps1
!/scripts/*.bat
!/scripts/*.cmd
/tests/*
!/tests/*.mjs
!/tests/*.py
/tools/*
!/tools/training/
/docs/*
!/docs/ORVYN-1.md
!/docs/OPEX-PC.txt
!/docs/workspace-features.md
!/docs/orvyn-logo-prompt.txt

# Defence in depth for generated files, weights and credentials in source folders.
**/node_modules/
**/__pycache__/
**/.next/
**/.npm-cache/
**/target/
**/build-usb/
**/build-styled/
**/build-webview/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.gguf*
**/*.safetensors
**/*.pt
**/*.pth
**/*.exe
**/*.dll
**/*.log
**/*.tsbuildinfo
**/api-providers.json
**/desktop-session.json
**/chats.json
**/services.lock
**/Thumbs.db
**/.DS_Store

# Application license and release documentation
!/LICENSE
!/docs/RELEASE-NOTES-0.7.0.md

# GitHub collaboration configuration
!/.github/
!/docs/GITHUB.md
!/docs/ISSUE-BACKLOG.md

# Detailed development guide
!/docs/DEVELOPMENT.md

# Application licensing guide
!/docs/LICENSING.md
